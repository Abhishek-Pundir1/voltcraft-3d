{
  "functions": {
    "api/*.php": { "runtime": "vercel-php@0.6.1" },
    "*.php": { "runtime": "vercel-php@0.6.1" },
    "customer/*.php": { "runtime": "vercel-php@0.6.1" },
    "engineer/*.php": { "runtime": "vercel-php@0.6.1" },
    "admin/*.php": { "runtime": "vercel-php@0.6.1" },
    "includes/*.php": { "runtime": "vercel-php@0.6.1" }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*\\.php)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
